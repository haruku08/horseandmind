# Horse & Mind – Apache settings for the static site

# Always use HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old WordPress URLs → new pages (keeps Google rankings and old links working).
# Found via Google's index on 25 Oct 2026; complete the list after a full crawl of the old site.
Redirect 301 /kids-mini-camp/ /kids/land-der-gefuehle/
Redirect 301 /kids/workshop/ /kids/
Redirect 301 /manuela-pattynama/ /ueber-uns/
Redirect 301 /ueber-uns/unsere-pferde/ /ueber-uns/
Redirect 301 /pferdegestuetztes-coaching-2/ /pferdeunterstuetztes-coaching/
Redirect 301 /pferdeunterstuetztes-coaching/erwachsene/ /pferdeunterstuetztes-coaching/
Redirect 301 /pferdeunterstuetztes-coaching/intensiv-coaching/ /ruhe-im-chaos/
Redirect 301 /pferdegestuetztes-coaching-winterthur/kinder-jugendliche-intensiv-coaching/ /kids/in-der-ruhe-liegt-die-kraft-mit-pferden/
Redirect 301 /pferdegestuetztes-coaching-winterthur/wieherndes-klassenzimmer/ /kids/
RedirectMatch 301 ^/pferdegestuetztes-coaching-winterthur/?$ /pferdeunterstuetztes-coaching/
Redirect 301 /privacy-policy/ /datenschutz/
Redirect 301 /wp-admin /
Redirect 301 /wp-login.php /
RedirectMatch 301 ^/feed/?$ /
RedirectMatch 301 ^/category/.*$ /
RedirectMatch 301 ^/tag/.*$ /
RedirectMatch 301 ^/page_category/.*$ /
# Old Bookly booking pages (/buchung/…) → appointment page; our own camp sign-up lives at /buchung/land-der-gefuehle/
RewriteCond %{REQUEST_URI} !^/buchung/land-der-gefuehle/
RewriteRule ^buchung/ /termin/ [R=301,L]

ErrorDocument 404 /404/index.html

AddType font/woff2 .woff2
AddType text/plain .txt
AddDefaultCharset utf-8

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# Caching: CSS/JS carry a version in their URL, images rarely change
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

Options -Indexes
