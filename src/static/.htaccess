# Horse & Mind – Apache settings for the static site

# Always use HTTPS and the bare domain
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old WordPress URLs → new pages (keeps Google rankings and old links working).
# Complete list from the crawl of 13 Nov 2026 (all 54 pages of the old sitemap + older addresses from Google).
# First match wins. NE keeps the # in targets intact.
RewriteRule ^kids-mini-camp/?$ /kids/land-der-gefuehle/ [R=301,L,NE]
RewriteRule ^kids/workshop/?$ /kids/ [R=301,L,NE]
RewriteRule ^kids/kinder-jugendliche/?$ /kids/in-der-ruhe-liegt-die-kraft-mit-pferden/ [R=301,L,NE]
RewriteRule ^ueber-uns/unsere-pferde/?$ /ueber-uns/#pferde [R=301,L,NE]
RewriteRule ^pferdeunterstuetztes-coaching/erwachsene/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^pferdeunterstuetztes-coaching/intensiv-coaching/?$ /ruhe-im-chaos/ [R=301,L,NE]
RewriteRule ^privacy-policy/?$ /datenschutz/ [R=301,L,NE]
RewriteRule ^(archive/)?manuela-pattynama/?$ /ueber-uns/ [R=301,L,NE]
RewriteRule ^(archive/)?coaching-mit-pferden/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^(archive/)?life-coaching/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^(archive/)?epigenetik-stress-workshop/?$ /epigenetik/ [R=301,L,NE]
RewriteRule ^(archive/)?trauma-workshop/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^(archive/)?workshop/?$ /kids/ [R=301,L,NE]
RewriteRule ^(archive/)?pferdegestuetztescoaching/?$ / [R=301,L,NE]
RewriteRule ^pferdegestuetztes-coaching-2/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^(archive/|pferdegestuetztes-coaching-winterthur/)kinder-jugendliche-intensiv-coaching/?$ /kids/in-der-ruhe-liegt-die-kraft-mit-pferden/ [R=301,L,NE]
RewriteRule ^(archive/|pferdegestuetztes-coaching-winterthur/)wieherndes-klassenzimmer/?$ /kids/ [R=301,L,NE]
RewriteRule ^(archive/)?pferdegestuetztes-coaching-winterthur/?$ /pferdeunterstuetztes-coaching/ [R=301,L,NE]
RewriteRule ^archive(/.*)?$ / [R=301,L,NE]
RewriteRule ^buchung/danke/?$ /danke/ [R=301,L,NE]
RewriteRule ^buchung/(booking-mini-camp-[^/]+|mini-camp-[^/]+)/?$ /kids/land-der-gefuehle/ [R=301,L,NE]
RewriteRule ^buchung/(booking-reitpaedagogik|reitpaedagogik-[^/]+)/?$ /kids/reitpaedagogik/ [R=301,L,NE]
RewriteRule ^buchung/booking-pferdegestuetztes-coaching-wingwave/?$ /wing-wave/ [R=301,L,NE]
RewriteRule ^buchung/booking-intensive-workshop/?$ /ruhe-im-chaos/ [R=301,L,NE]
RewriteRule ^buchung/(booking-kids-workshop-[^/]+|kids-workshops|pferdegestuetztes-coaching-wieherndes-klassenzimmer)/?$ /kids/ [R=301,L,NE]
RewriteRule ^buchung/pferdegestuetztes-coaching-teams-familien/?$ /pferdeunterstuetztes-coaching/leadership-team-coaching/ [R=301,L,NE]
RewriteRule ^buchung/(?!land-der-gefuehle/).*$ /termin/ [R=301,L,NE]
RewriteRule ^(wp-admin|wp-login\.php).*$ / [R=301,L,NE]
RewriteRule ^(feed|category|tag|page_category)(/.*)?$ / [R=301,L,NE]

ErrorDocument 404 /404/index.html

AddType font/woff2 .woff2
AddType text/plain .txt
AddDefaultCharset utf-8

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml
</IfModule>

# Caching: CSS/JS carry a version in their URL, images rarely change
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

Options -Indexes
